# --- Database (Neon) ---
# Pooled connection string, used by the app at runtime.
# In Neon: Dashboard -> your project -> Connect -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection string, used only by `prisma migrate`.
# In Neon: same Connect dialog -> "Direct connection".
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth ---
# Secret used to sign/verify session JWTs. Generate with:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# --- Seed script (prisma/seed.ts) ---
# The one hardcoded user's login credentials. Only needed when running
# `npm run db:seed`; not required at app runtime.
SEED_USERNAME="admin"
SEED_PASSWORD="replace-with-a-strong-password"
